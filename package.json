{
  "name": "jobrun",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "import:data": "node --env-file-if-exists=.env.local --import tsx scripts/import-data.mts",
    "geocode": "node --env-file-if-exists=.env.local --import tsx scripts/geocode-properties.mts",
    "test": "vitest run",
    "db:types": "supabase gen types typescript --project-id uvcivtqkdixosgulpwjd --schema public > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.3.4"
}
