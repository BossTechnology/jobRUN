# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# true → the board runs on simulated data (the prototype's behavior). Flip to false once Supabase is loaded.
NEXT_PUBLIC_SIMULATE=true
BUSINESS_TZ=America/New_York

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — import script, webhooks, crons

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=           # public token (pk.*), restricted to your domains
MAPBOX_GEOCODING_TOKEN=             # used once by scripts/geocode-properties.ts
TOMTOM_TRAFFIC_KEY=
OPENWEATHER_KEY=

# Rosie (server only)
ANTHROPIC_API_KEY=
ROSIE_MODEL=claude-sonnet-5

# Integrations (fill as PINCH provides access)
GMAIL_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=                 # outbound SMS (cron texts) until TrueDialog is wired
TWILIO_AUTH_TOKEN=                  # also verifies /api/in/twilio signatures
TWILIO_FROM=                        # sending number, E.164
TRUEDIALOG_KEY=
ZENDESK_SUBDOMAIN=                  # mirror of messages and stage changes as internal ticket comments
ZENDESK_EMAIL=
ZENDESK_TOKEN=
WORKAPP_KEY=
TRACWORK_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron invocations.
CRON_SECRET=
